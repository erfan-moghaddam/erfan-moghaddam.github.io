{
  "name": "erfan-engineering-field-notes",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "eslint src scripts tests",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/content.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run build && npm run lint && npm run typecheck && npm test && npm run test:browser"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "eslint": "10.15.0",
    "typescript": "7.0.2"
  }
}
